{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/aviso-legal.html/",
      "destination": "/aviso-legal.html",
      "statusCode": 301
    },
    {
      "source": "/politica-de-privacidad/",
      "destination": "/privacidad.html",
      "statusCode": 301
    },
    {
      "source": "/politica-de-cookies/",
      "destination": "/cookies.html",
      "statusCode": 301
    },
    {
      "source": "/aviso-legal/",
      "destination": "/aviso-legal.html",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/wp-content/themes/hello-elementor(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/wp-content/uploads(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/wp-[^/]+\\.php$",
      "status": 410
    },
    {
      "src": "^/wp-json/elementskit/v1(?:/.*)?$",
      "status": 410
    },
    {
      "src": "^/wp-includes(?:/.*)?$",
      "status": 410
    }
  ]
}
